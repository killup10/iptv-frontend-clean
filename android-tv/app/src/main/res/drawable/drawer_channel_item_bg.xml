<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D-Pad Focus / Selected State on TV (highest priority, bright white border with red tint) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#55E50914" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#55E50914" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Currently playing channel (when not focused) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E50914" />
            <stroke android:width="1.5dp" android:color="#E50914" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="0.5dp" android:color="#14FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
