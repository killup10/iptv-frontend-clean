<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- Controles superiores (título y volver) -->
    <LinearLayout
        android:id="@+id/top_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/tv_exo_top_panel_background"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/mobile_player_button_secondary"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Volver" />

        <TextView
            android:id="@+id/video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/brightness_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="150dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="-60dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:rotation="270"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/volume_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="150dp"
        android:layout_height="20dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="-60dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:rotation="270"
        android:visibility="gone" />

    <!-- Barra de progreso para desbloqueo de pantalla -->
    <ProgressBar
        android:id="@+id/unlock_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="8dp"
        android:layout_centerInParent="true"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:visibility="gone"
        android:max="100" />

    <!-- CONTENEDOR PRINCIPAL DE CONTROLES (Ahora abarca toda la pantalla para centrar los botones principales) -->
    <RelativeLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- BOTONES DE REPRODUCCIÓN EN EL CENTRO -->
        <LinearLayout
            android:id="@+id/center_playback_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev_episode_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_prev"
                android:background="@drawable/mobile_player_button_secondary"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="Episodio Anterior"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/rewind_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_rewind"
                android:background="@drawable/mobile_player_button_secondary"
                android:layout_marginStart="20dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:contentDescription="Rewind"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/play_pause_button"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/mobile_player_button_primary"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/forward_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_forward"
                android:background="@drawable/mobile_player_button_secondary"
                android:layout_marginEnd="20dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:contentDescription="Forward"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/next_episode_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_next"
                android:background="@drawable/mobile_player_button_secondary"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="Siguiente Episodio"
                android:visibility="gone" />
        </LinearLayout>

        <!-- PANEL DE CONTROLES INFERIORES -->
        <LinearLayout
            android:id="@+id/bottom_controls_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:background="@drawable/tv_exo_bottom_panel_background"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila del SeekBar y los tiempos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DDFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="00:00" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:progressDrawable="@drawable/tv_exo_seekbar_progress"
                    android:thumb="@drawable/tv_exo_seekbar_thumb"
                    android:thumbOffset="8dp"
                    android:splitTrack="false"
                    android:maxHeight="10dp"
                    android:minHeight="10dp" />

                <TextView
                    android:id="@+id/totalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DDFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="00:00" />
            </LinearLayout>

            <!-- Fila de opciones secundarias -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/tracks_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_tracks"
                        android:background="@drawable/mobile_player_button_secondary"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Audio/Subtitles" />

                    <ImageButton
                        android:id="@+id/aspect_ratio_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_aspect_ratio"
                        android:background="@drawable/mobile_player_button_secondary"
                        android:layout_marginStart="12dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Aspect Ratio" />

                    <ImageButton
                        android:id="@+id/speed_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_speed"
                        android:background="@drawable/mobile_player_button_secondary"
                        android:layout_marginStart="12dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Velocidad de reproducción" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/channels_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_channels"
                        android:background="@drawable/mobile_player_button_secondary"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Channel List" />

                    <ImageButton
                        android:id="@+id/lock_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_lock"
                        android:background="@drawable/mobile_player_button_secondary"
                        android:layout_marginStart="12dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Bloquear Pantalla" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- BACKDROP PARA CERRAR EL DRAWER TOCANDO EL VIDEO (ZONA DERECHA) -->
    <View
        android:id="@+id/channel_drawer_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false" />

    <!-- PANEL LATERAL OSD (DRAWER ESTILO OTT NAVIGATOR / TIVIMATE) -->
    <LinearLayout
        android:id="@+id/channel_drawer_container"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="horizontal"
        android:background="#F20D0A17"
        android:elevation="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 1. RAIL VERTICAL IZQUIERDO DE ICONOS -->
        <LinearLayout
            android:id="@+id/drawer_rail"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#CC07050E"
            android:gravity="center_horizontal"
            android:paddingTop="16dp">

            <ImageButton
                android:id="@+id/rail_tab_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/mobile_player_button_secondary"
                android:src="@drawable/ic_search_white"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="Buscar" />

            <ImageButton
                android:id="@+id/rail_tab_history"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/mobile_player_button_secondary"
                android:src="@drawable/ic_history_white"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="Recientes" />

            <ImageButton
                android:id="@+id/rail_tab_favorites"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/mobile_player_button_secondary"
                android:src="@drawable/ic_star_white"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="Favoritos" />

            <ImageButton
                android:id="@+id/rail_tab_channels"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/mobile_player_button_primary"
                android:src="@drawable/ic_list_white"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:contentDescription="Lista de Canales" />
        </LinearLayout>

        <!-- 2. CONTENIDO PRINCIPAL DEL DRAWER (LISTA DE CANALES) -->
        <LinearLayout
            android:id="@+id/drawer_channels_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- HEADER: TÍTULO Y HORA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/drawer_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lista de canales"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawer_header_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00"
                    android:textColor="#A0A0B0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- CAJA DE BÚSQUEDA COMPACTA -->
            <EditText
                android:id="@+id/drawer_search_input"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/drawer_search_bg"
                android:hint="Buscar canal..."
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A8E"
                android:textSize="12sp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- LISTVIEW DE CANALES (RECICLADO ULTRA-RÁPIDO) -->
            <ListView
                android:id="@+id/drawer_channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:scrollbars="vertical"
                android:choiceMode="singleChoice"
                android:clipToPadding="false" />

            <!-- PIE INFORMATIVO -->
            <TextView
                android:id="@+id/drawer_footer_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Toca un canal para sintonizar"
                android:textColor="#666677"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 3. SUB-PANEL DE GUÍA EPG DEL CANAL (HOY Y RECORDATORIOS) -->
        <LinearLayout
            android:id="@+id/drawer_schedule_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- HEADER CON BOTÓN VOLVER Y TÍTULO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/schedule_btn_back"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/mobile_player_button_secondary"
                    android:src="@drawable/ic_back"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Volver" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/schedule_channel_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Canal"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Programación de hoy"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- LOADING SPINNER -->
            <ProgressBar
                android:id="@+id/schedule_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:indeterminateTint="#00E5FF"
                android:visibility="gone" />

            <!-- LISTVIEW DE PROGRAMAS -->
            <ListView
                android:id="@+id/schedule_program_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="8dp"
                android:scrollbars="vertical"
                android:clipToPadding="false" />

            <!-- EMPTY STATE -->
            <TextView
                android:id="@+id/schedule_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sin programación detallada para hoy."
                android:textColor="#7A7A8E"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
